# ==== Copia este archivo a ".env" y rellena tus claves ====

# Clave de la API de Anthropic (https://console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxx

# Modelo de Claude a usar
CLAUDE_MODEL=claude-sonnet-4-5

# Token del bot de Telegram (te lo da @BotFather)
TELEGRAM_BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Tu ID de chat de Telegram (para que solo TÚ puedas usar el bot y recibir recordatorios)
# Obtenlo escribiendo a @userinfobot en Telegram
TELEGRAM_ALLOWED_CHAT_ID=123456789

# ---- Notion ----
# Token de integración interna (https://www.notion.so/my-integrations)
NOTION_TOKEN=ntn_xxxxxxxxxxxxxxxx
# ID de la base de datos de tareas (ver README)
NOTION_TASKS_DB_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ---- Google Calendar ----
# ID del calendario ("primary" para tu calendario principal)
GOOGLE_CALENDAR_ID=primary

# Zona horaria (formato IANA)
TIMEZONE=Europe/Madrid

# Cada cuántos minutos revisar recordatorios
REMINDER_INTERVAL_MINUTES=15
